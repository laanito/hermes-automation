# User crontab block (set BASE to this overlay)
SHELL=/bin/bash
PATH=/home/USER/.local/bin:/usr/bin:/bin
BASE=/path/to/overlay
*/10 * * * * $BASE/bin/run-watch.sh bridges -- $BASE/watches/check-bridges.sh >>$BASE/logs/watches.log 2>&1
3-59/10 * * * * $BASE/bin/run-watch.sh nextcloud -- $BASE/watches/check-nextcloud.sh >>$BASE/logs/watches.log 2>&1
17 * * * * $BASE/bin/run-watch.sh disk -- $BASE/watches/check-disk.sh >>$BASE/logs/watches.log 2>&1
30 9 * * * $BASE/bin/run-watch.sh hermes-update -- $BASE/watches/check-hermes-update.sh >>$BASE/logs/watches.log 2>&1
15 8 * * 1-5 $BASE/bin/run-web-digest.sh
