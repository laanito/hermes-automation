+def _hermes_email_plainify(body: str) -> str:
+    """Best-effort Markdown → readable plain text for email clients."""
+    if not body:
+        return body
+    s = body.replace("\r\n", "\n")
+    s = re.sub(r"```[a-zA-Z0-9_+-]*\n([\s\S]*?)```", r"\1", s)
+    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r"\1 (\2)", s)
+    s = re.sub(r"(?m)^#{1,6}\s*", "", s)
+    s = re.sub(r"\*\*([^*]+)\*\*", r"\1", s)
+    s = re.sub(r"__([^_]+)__", r"\1", s)
+    s = re.sub(r"(?<!\w)\*([^*]+)\*(?!\w)", r"\1", s)
+    s = re.sub(r"(?<!\w)_([^_]+)_(?!\w)", r"\1", s)
+    s = re.sub(r"`([^`]+)`", r"\1", s)
+    s = re.sub(r"\n{3,}", "\n\n", s)
+    return s.strip() + "\n"
+
