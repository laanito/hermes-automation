[Unit]
Description=Nextcloud Talk Hermes Bridge (Automation Hermes)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@OVERLAY_ROOT@/bridge
Environment=PATH=%h/.local/bin:%h/.hermes/bin:/usr/bin:/bin
EnvironmentFile=@OVERLAY_ROOT@/.env
ExecStart=@OVERLAY_ROOT@/bridge/.venv/bin/python -m nextcloud_talk_hermes_bridge.bridge
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
